# Google OAuth
GOOGLE_CLIENT_ID=seu_client_id_aqui
GOOGLE_CLIENT_SECRET=seu_client_secret_aqui

# JWT Secret (gere com: openssl rand -hex 32)
JWT_SECRET=gere_um_secret_forte_aqui

# URL do frontend (para CORS)
# Local: http://localhost:8080
# Produção: https://financeiro.seudominio.com
FRONTEND_URL=http://localhost:8080

# Google Client ID para o frontend (VITE_)
VITE_GOOGLE_CLIENT_ID=seu_client_id_aqui

# Bot API Key (gere com: openssl rand -hex 32)
BOT_API_KEY=gere_um_secret_forte_aqui

# Senha do PostgreSQL (gere com: openssl rand -hex 32)
POSTGRES_PASSWORD=gere_um_secret_forte_aqui

# Domínio do site (ex: financeiro.seudominio.com)
DOMAIN_NAME=financeiro.seudominio.com
