{
  "name": "meu-financeiro",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:backend & npm run dev:frontend",
    "dev:frontend": "npm run dev -w packages/frontend",
    "dev:backend": "npm run dev -w packages/backend",
    "dev:bot": "npm run dev -w packages/bot",
    "build": "npm run build -w packages/frontend",
    "start": "npm run start -w packages/backend",
    "start:bot": "npm run start -w packages/bot",
    "test": "npm run test -w packages/backend",
    "test:coverage": "npm run test:coverage -w packages/backend",
    "test:e2e": "cd e2e && npx playwright test",
    "test:e2e:ui": "cd e2e && npx playwright test --ui"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "App financeiro pessoal"
}
